<canvas
  data-waves
  aria-hidden="true"
  class="absolute inset-0 block h-full w-full"
></canvas>
<script>
  (function () {
    const canvas = document.querySelector("[data-waves]");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduceMotion =
      globalThis.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let ink = "#2b2b2b";
    let accent = "#e5533c";
    let bg = "#ffffff";
    function readPalette() {
      const s = getComputedStyle(document.body);
      ink = s.getPropertyValue("--color-ink").trim() || ink;
      accent = s.getPropertyValue("--color-accent").trim() || accent;

      const bgMatch = s.getPropertyValue("background-color") ||
        getComputedStyle(document.documentElement).backgroundColor;
      if (bgMatch !== "rgba(0, 0, 0, 0)" && bgMatch !== "transparent") {
        bg = bgMatch;
      }
    }

    function withAlpha(color, a) {
      return "color-mix(in oklch, " + color + " " + Math.round(a * 100) +
        "%, transparent)";
    }

    let W = 0, H = 0, dpr = 1;
    let lanes = [];

    const pointer = { x: -9999, y: -9999, on: 0, hovering: false };

    // Normalized function to generate a noisy analog signal between 0 and 1
    function getSignal(t) {
      const base = Math.sin(t) * 0.6 + Math.sin(t * 2.3 + 1.1) * 0.28 +
        Math.sin(t * 0.5 + 0.5) * 0.32;
      const noise = Math.sin(t * 19.3) * 0.08 + Math.sin(t * 43.7) * 0.05 +
        Math.sin(t * 89.5) * 0.03;
      // Max theoretical amplitude is ~1.36. Shift and scale to bounds of 0 to 1.
      const normalized = (base + noise + 1.36) / 2.72;
      return Math.max(0, Math.min(1, normalized)); // Clamp strictly to 0-1 range
    }

    function generate() {
      lanes = [];
      const laneH = 80 * dpr;
      const count = Math.max(2, Math.floor(H / laneH));
      const pad = (H - count * laneH) / 2;

      for (let i = 0; i < count; i++) {
        const top = pad + i * laneH;
        const midY = top + laneH / 2;

        const isAnalog = i % 2 === 0;
        const pairIndex = Math.floor(i / 2);

        const wl = (70 + (pairIndex * 40 % 100)) * dpr;
        const speed = (12 + (pairIndex * 7 % 20)) * dpr;
        const phase = pairIndex * 5.3;
        const bw = (18 + (pairIndex * 5 % 15)) * dpr;

        if (isAnalog) {
          lanes.push({
            type: "analog",
            midY,
            amp: laneH * 0.45,
            wl,
            speed,
            phase,
            bw,
          });
        } else {
          lanes.push({
            type: "digital",
            highY: top + laneH * 0.15,
            lowY: top + laneH * 0.85,
            wl,
            speed,
            phase,
            bw,
          });
        }
      }
    }

    function laneCenter(i) {
      const l = lanes[i];
      return l.type === "analog" ? l.midY : (l.highY + l.lowY) / 2;
    }

    function getHoveredLaneIndex() {
      if (pointer.on <= 0 || pointer.y < 0) return -1;
      let minDistance = Infinity;
      let activeIndex = -1;
      for (let i = 0; i < lanes.length; i++) {
        const dist = Math.abs(laneCenter(i) - pointer.y);
        if (dist < 40 * dpr && dist < minDistance) {
          minDistance = dist;
          activeIndex = i;
        }
      }
      return activeIndex;
    }

    function laneColor(i, base) {
      const activeIndex = getHoveredLaneIndex();
      if (i === activeIndex) {
        return withAlpha(accent, 0.45 + 0.45 * pointer.on);
      }
      return base;
    }

    function drawDigital(l, i, offset) {
      const bw = l.bw;
      const first = Math.floor(offset / bw) - 1;
      ctx.beginPath();
      let prevY = null;

      for (let k = first;; k++) {
        const x0 = k * bw - offset;
        if (x0 > W) break;

        const sampleX = k * bw + bw / 2;
        const t = sampleX / l.wl + l.phase;
        const v = getSignal(t); // returns 0 to 1

        // Threshold at 0.5 (represents 2.5V logic threshold)
        const y = v >= 0.5 ? l.highY : l.lowY;

        if (prevY === null) {
          ctx.moveTo(x0, y);
        } else if (prevY !== y) {
          ctx.lineTo(x0, prevY);
          ctx.lineTo(x0, y);
        }
        ctx.lineTo(x0 + bw, y);
        prevY = y;
      }
      ctx.strokeStyle = laneColor(i, withAlpha(ink, 0.22));
      ctx.stroke();
    }

    function drawAnalog(l, i, offset) {
      const step = 2 * dpr;
      ctx.beginPath();
      for (let x = 0; x <= W; x += step) {
        const t = (x + offset) / l.wl + l.phase;
        const v = getSignal(t); // 0 to 1

        // Map 0 to bottom, 1 to top
        const y = l.midY + (0.5 - v) * (l.amp * 2);

        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = laneColor(i, withAlpha(ink, 0.18));
      ctx.stroke();
    }

    function drawCursor(baseTime) {
      if (pointer.on <= 0 || pointer.x < 0) return;
      ctx.save();

      const alpha = pointer.on;

      // Crosshairs
      ctx.setLineDash([4 * dpr, 4 * dpr]);
      ctx.lineWidth = 1 * dpr;
      ctx.strokeStyle = withAlpha(accent, 0.5 * alpha);
      ctx.beginPath();
      ctx.moveTo(pointer.x, 0);
      ctx.lineTo(pointer.x, H);
      ctx.moveTo(0, pointer.y);
      ctx.lineTo(W, pointer.y);
      ctx.stroke();

      const activeIdx = getHoveredLaneIndex();
      if (activeIdx !== -1) {
        const l = lanes[activeIdx];
        const offset = baseTime * l.speed;
        let voltage = 0;
        let waveY = 0;

        if (l.type === "analog") {
          const t = (pointer.x + offset) / l.wl + l.phase;
          const v = getSignal(t); // 0 to 1
          voltage = v * 5.0; // Strictly 0.00V to 5.00V
          waveY = l.midY + (0.5 - v) * (l.amp * 2);
        } else {
          const bw = l.bw;
          const k = Math.floor((pointer.x + offset) / bw);
          const sampleX = k * bw + bw / 2;
          const t = sampleX / l.wl + l.phase;
          const v = getSignal(t); // 0 to 1
          voltage = v >= 0.5 ? 5.0 : 0.0;
          waveY = v >= 0.5 ? l.highY : l.lowY;
        }

        // Target dot on waveform
        ctx.setLineDash([]);
        ctx.beginPath();
        ctx.arc(pointer.x, waveY, 5 * dpr, 0, Math.PI * 2);
        ctx.fillStyle = bg;
        ctx.fill();
        ctx.lineWidth = 2 * dpr;
        ctx.strokeStyle = withAlpha(accent, 0.9 * alpha);
        ctx.stroke();

        // Voltage Tooltip
        const vText = voltage.toFixed(2) + " V";
        ctx.font = `600 ${11 * dpr}px monospace`;
        const metrics = ctx.measureText(vText);
        const tw = metrics.width;
        const th = 14 * dpr;

        let tx = pointer.x + 12 * dpr;
        let ty = pointer.y - 12 * dpr;

        if (tx + tw + 16 * dpr > W) tx = pointer.x - tw - 20 * dpr;
        if (ty - th - 8 * dpr < 0) ty = pointer.y + 24 * dpr;

        ctx.fillStyle = withAlpha(ink, 0.9 * alpha);
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(
            tx,
            ty - th - 4 * dpr,
            tw + 12 * dpr,
            th + 8 * dpr,
            4 * dpr,
          );
        } else {
          ctx.rect(tx, ty - th - 4 * dpr, tw + 12 * dpr, th + 8 * dpr);
        }
        ctx.fill();

        ctx.fillStyle = withAlpha(bg, alpha);
        ctx.fillText(vText, tx + 6 * dpr, ty);
      }

      ctx.restore();
    }

    function draw(time) {
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1.3 * dpr;
      ctx.lineJoin = "round";
      ctx.lineCap = "butt";

      const base = reduceMotion ? 0 : time / 1000;
      for (let i = 0; i < lanes.length; i++) {
        const l = lanes[i];
        const offset = base * l.speed;
        if (l.type === "digital") drawDigital(l, i, offset);
        else drawAnalog(l, i, offset);
      }
      drawCursor(base);
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      dpr = Math.min(globalThis.devicePixelRatio || 1, 2);
      W = Math.round(rect.width * dpr);
      H = Math.round(rect.height * dpr);
      canvas.width = W;
      canvas.height = H;
      generate();
      draw(performance.now());
    }

    let running = false;
    let visible = true;
    function frame(t) {
      if (!running) return;
      draw(t);
      if (pointer.on > 0 && !pointer.hovering) {
        pointer.on = Math.max(0, pointer.on - 0.04);
        if (pointer.on === 0) pointer.x = pointer.y = -9999;
      }
      requestAnimationFrame(frame);
    }

    function start() {
      if (running || !visible || document.hidden) return;
      running = true;
      requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
    }

    canvas.addEventListener("pointermove", function (e) {
      const rect = canvas.getBoundingClientRect();
      pointer.x = (e.clientX - rect.left) * dpr;
      pointer.y = (e.clientY - rect.top) * dpr;
      pointer.on = 1;
      pointer.hovering = true;
      if (reduceMotion) draw(performance.now());
    });

    canvas.addEventListener("pointerleave", function () {
      pointer.hovering = false;
      if (reduceMotion) {
        pointer.on = 0;
        pointer.x = pointer.y = -9999;
        draw(performance.now());
      }
    });

    readPalette();
    resize();

    if (!reduceMotion) {
      const io = new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        if (visible) start();
        else stop();
      });
      io.observe(canvas);
      document.addEventListener("visibilitychange", function () {
        if (document.hidden) stop();
        else start();
      });
      start();
    }

    globalThis.addEventListener("resize", resize);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(resize).observe(canvas);
    }

    const mq = globalThis.matchMedia("(prefers-color-scheme: dark)");
    mq.addEventListener("change", function () {
      readPalette();
      draw(performance.now());
    });

    new MutationObserver(function () {
      readPalette();
      draw(performance.now());
    }).observe(document.body, {
      attributes: true,
      attributeFilter: ["data-color", "style", "class"],
    });
  })();
</script>
