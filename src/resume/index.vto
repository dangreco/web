---
title: Résumé
layout: layouts/main.vto
---

{{
  set base = "https://dangreco-resume.s3.ca-central-1.amazonaws.com/production"
}}

<section class="rule-bottom">
  <div
    class="mx-auto max-w-[1200px] px-6 lg:px-10 pt-16 pb-14 lg:pt-24 lg:pb-20"
  >
    <div class="flex items-center gap-3 mb-8">
      <div class="eyebrow mb-3">03 / Résumé</div>
    </div>
    <h1
      class="font-display font-semibold tracking-[-0.025em] text-[clamp(2.5rem,6vw,4.75rem)] leading-[0.95] text-ink text-balance max-w-[20ch]"
    >
      Download the resume, and verify it if you like.
    </h1>
    <p class="mt-6 max-w-[58ch] text-[16px] leading-[1.6] text-ink-soft">
      A single PDF. It's GPG-signed and published with a SHA-256 checksum, so
      you can verify its authenticity before you read it.
    </p>
  </div>
</section>

<section
  class="mx-auto max-w-[1200px] px-6 lg:px-10 py-16 grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12"
>
  {{# Download #}}
  <div class="space-y-8">
    <div>
      <div class="eyebrow mb-4">Download</div>
      <a
        href="{{ base }}/resume.en.pdf"
        class="block border border-accent bg-accent text-accent-ink p-5 hover:brightness-90 transition group"
      >
        <div class="flex items-center justify-between">
          <div>
            <div class="text-[13px] uppercase tracking-widest opacity-70">
              PDF
            </div>
            <div class="font-display text-[20px] font-semibold mt-1">
              resume.en.pdf
            </div>
          </div>
          <span aria-hidden class="text-2xl">↓</span>
        </div>
      </a>
    </div>

    <div class="text-[13px] text-ink-mute leading-[1.6]">
      Prefer a conversation? →
      <a href="https://linkedin.com/in/danrgreco" class="link-accent"
      >LinkedIn</a>
    </div>
  </div>

  {{# Verification #}}
  <aside class="space-y-8">
    <div>
      <div class="eyebrow mb-4">Verification (optional)</div>
      <dl class="border border-rule divide-y divide-rule text-[12px]">
        <div class="p-4">
          <dt class="index-num mb-2">GPG signature</dt>
          <dd class="font-mono leading-[1.6] text-ink-soft">
            <a href="{{ base }}/resume.en.pdf.asc" class="link-accent"
            >resume.en.pdf.asc</a>
          </dd>
        </div>
        <div class="p-4">
          <dt class="index-num mb-2">SHA-256 checksum</dt>
          <dd class="font-mono leading-[1.6] text-ink-soft">
            <a href="{{ base }}/checksums.txt" class="link-accent"
            >checksums.txt</a>
          </dd>
        </div>
      </dl>
      <details class="mt-4 text-[13px] text-ink-soft">
        <summary
          class="cursor-pointer text-ink font-medium hover:text-accent transition-colors"
        >
          How to verify
        </summary>
        <pre
          class="mt-3 bg-panel border border-rule rounded-md p-4 font-mono text-[12px] leading-[1.7] overflow-x-auto text-ink"
        >
# import my GPG public key
curl https://github.com/dangreco.gpg | gpg --import

# verify the signature
gpg --verify resume.en.pdf.asc resume.en.pdf

# verify the checksum
sha256sum -c checksums.txt</pre>
      </details>
    </div>
  </aside>
</section>
