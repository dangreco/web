<!DOCTYPE html>
<html lang="en">
  {{ await comp.meta.head({ title, url, description }) }}
  <body class="min-h-[100dvh] bg-paper text-ink font-sans flex flex-col">
    {{ await comp.layout.header() }}
    <main class="flex-1 flex items-center">
      <article
        class="prose max-w-none mx-auto max-w-[1200px] px-6 lg:px-10 py-20 lg:py-28"
      >
        {{ content }}
      </article>
    </main>
    {{ await comp.layout.footer() }}
  </body>
</html>
